# Copy this file to backend/.env and change the values before deploying.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Database (MySQL) ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your-database
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Change these — they seed the admin account on first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Any long random string. Changing it signs everyone out.
JWT_SECRET=change-this-to-a-long-random-string

# ── Outgoing mail (contact form) ─────────────────────────────────────────
# SMTP account used to send the lead notification and the customer's
# thank-you email. Port 465 = implicit TLS, so SMTP_SECURE must be true.
SMTP_HOST=mail.saeedaccounting.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@saeedaccounting.com
SMTP_PASS=your-email-account-password

# From-address shown to recipients, and the inbox that receives new leads.
MAIL_FROM_NAME=Saeed Accounting
MAIL_FROM=info@saeedaccounting.com
LEADS_INBOX=info@saeedaccounting.com

# ── Website "WhatsApp us" button ─────────────────────────────────────────
# The per-day numbers are managed in the admin panel (WhatsApp page). These
# are the fallback used when today's scheduled number is inactive or missing,
# so the button never points at a dead number.
WHATSAPP_DEFAULT_NUMBER=971508365223
WHATSAPP_DEFAULT_MESSAGE="Hello Saeed Accounting, We are Seeking for VAT Services."
